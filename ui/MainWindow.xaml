<?xml version="1.0" encoding="utf-8"?>
<Grid xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      x:Name="Root"
      Width="348" Height="500"
      Background="Transparent"
      UseLayoutRounding="True"
      SnapsToDevicePixels="True"
      Language="zh-CN">

    <Grid.Resources>
        <SolidColorBrush x:Key="Ink" Color="#43362C"/>
        <SolidColorBrush x:Key="Muted" Color="#8E7A67"/>
        <SolidColorBrush x:Key="Faint" Color="#B6A38F"/>
        <SolidColorBrush x:Key="Coral" Color="#E2644C"/>
        <SolidColorBrush x:Key="CoralDeep" Color="#CF523B"/>
        <SolidColorBrush x:Key="Sage" Color="#6F9378"/>
        <SolidColorBrush x:Key="SageDeep" Color="#587C61"/>
        <SolidColorBrush x:Key="PaperLine" Color="#E8D8C4"/>
        <SolidColorBrush x:Key="PaperHover" Color="#FBF2E4"/>
        <SolidColorBrush x:Key="PaperPressed" Color="#F2E4D3"/>

        <LinearGradientBrush x:Key="CoralGradient" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#E8674E" Offset="0"/>
            <GradientStop Color="#F09A74" Offset="1"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="SageGradient" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#6F9378" Offset="0"/>
            <GradientStop Color="#A2C096" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="CardBackground" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#FFFDF9" Offset="0"/>
            <GradientStop Color="#FBF3E7" Offset="0.56"/>
            <GradientStop Color="#F3E6D3" Offset="1"/>
        </LinearGradientBrush>

        <Style x:Key="WindowButton" TargetType="Button">
            <Setter Property="Width" Value="24"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#8B7663"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}" CornerRadius="12">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#F0E2D0"/>
                                <Setter Property="Foreground" Value="#5E4A3A"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#E7D4BE"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CloseButton" TargetType="Button" BasedOn="{StaticResource WindowButton}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}" CornerRadius="12">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#E2644C"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#C74E39"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PinToggle" TargetType="ToggleButton">
            <Setter Property="Width" Value="24"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#8B7663"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}" CornerRadius="12">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#F0E2D0"/>
                                <Setter Property="Foreground" Value="#5E4A3A"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#E2644C"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsChecked" Value="True"/>
                                    <Condition Property="IsMouseOver" Value="True"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="Bg" Property="Background" Value="#CF523B"/>
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PresetToggle" TargetType="ToggleButton">
            <Setter Property="Width" Value="62"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="Background" Value="#2EFFFCF7"/>
            <Setter Property="BorderBrush" Value="#E6D3BB"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="#806D5B"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontFamily" Value="Microsoft YaHei UI, Segoe UI"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Bg"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="16">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#FFF9EF"/>
                                <Setter TargetName="Bg" Property="BorderBrush" Value="#DCC6AB"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#E2644C"/>
                                <Setter TargetName="Bg" Property="BorderBrush" Value="#E2644C"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsChecked" Value="True"/>
                                    <Condition Property="IsMouseOver" Value="True"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="Bg" Property="Background" Value="#D4573F"/>
                                <Setter TargetName="Bg" Property="BorderBrush" Value="#D4573F"/>
                            </MultiTrigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Height" Value="46"/>
            <Setter Property="Background" Value="{StaticResource CoralGradient}"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontFamily" Value="Microsoft YaHei UI, Segoe UI"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}" CornerRadius="23">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Opacity" Value="0.95"/>
                                <Setter Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="1.015" ScaleY="1.015"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="0.985" ScaleY="0.985"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="RoundIconButton" TargetType="Button">
            <Setter Property="Width" Value="42"/>
            <Setter Property="Height" Value="42"/>
            <Setter Property="Background" Value="#FFFBF5"/>
            <Setter Property="BorderBrush" Value="#E6D4BE"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="#8A7460"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="21">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#FBF1E2"/>
                                <Setter Property="Foreground" Value="#5E4939"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#F2E3D0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="GhostButton" TargetType="Button">
            <Setter Property="Height" Value="38"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="#E0CEB8"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="#6B5747"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontFamily" Value="Microsoft YaHei UI, Segoe UI"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="19">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#FBF2E4"/>
                                <Setter TargetName="Bg" Property="BorderBrush" Value="#D6BFA4"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#F2E3D0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DialogPrimary" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="Height" Value="38"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}" CornerRadius="19">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Opacity" Value="0.94"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Opacity" Value="0.88"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="MiniChip" TargetType="Button">
            <Setter Property="Height" Value="26"/>
            <Setter Property="Width" Value="48"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="Background" Value="#FBF3E7"/>
            <Setter Property="BorderBrush" Value="#E7D5BF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="#806A56"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontFamily" Value="Microsoft YaHei UI, Segoe UI"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="13">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#F5E6D3"/>
                                <Setter TargetName="Bg" Property="BorderBrush" Value="#D9C0A3"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#EDDCC6"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DurationBox" TargetType="TextBox">
            <Setter Property="FontFamily" Value="Bahnschrift Light, Segoe UI"/>
            <Setter Property="FontSize" Value="22"/>
            <Setter Property="Foreground" Value="#43362C"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="CaretBrush" Value="#E2644C"/>
            <Setter Property="SelectionBrush" Value="#E2644C"/>
            <Setter Property="MaxLength" Value="3"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        </Style>
    </Grid.Resources>

    <!-- A sliver of translucent washi tape at the top, so the card reads like a note. -->
    <Border Width="78" Height="18"
            HorizontalAlignment="Center" VerticalAlignment="Top"
            Margin="0,8,0,0"
            CornerRadius="2"
            RenderTransformOrigin="0.5,0.5"
            Panel.ZIndex="5"
            IsHitTestVisible="False">
        <Border.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                <GradientStop Color="#C9EEE0C8" Offset="0"/>
                <GradientStop Color="#99E7D7BE" Offset="0.5"/>
                <GradientStop Color="#BFEDE1CB" Offset="1"/>
            </LinearGradientBrush>
        </Border.Background>
        <Border.Effect>
            <DropShadowEffect Color="#7D5B40" BlurRadius="6" ShadowDepth="2" Direction="270" Opacity="0.18"/>
        </Border.Effect>
        <Border.RenderTransform>
            <RotateTransform Angle="-2.4"/>
        </Border.RenderTransform>
    </Border>

    <Border x:Name="Card"
            Margin="18"
            CornerRadius="26"
            Background="{StaticResource CardBackground}"
            BorderBrush="#66FFFFFF"
            BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect Color="#4D3323" BlurRadius="26" ShadowDepth="7" Direction="270" Opacity="0.30"/>
        </Border.Effect>

        <Grid x:Name="CardGrid">
            <!-- Faint warm light in the upper-left corner. -->
            <Rectangle IsHitTestVisible="False" RadiusX="26" RadiusY="26" Opacity="0.62">
                <Rectangle.Fill>
                    <RadialGradientBrush Center="0.08,0.02" GradientOrigin="0.08,0.02" RadiusX="0.95" RadiusY="0.8">
                        <GradientStop Color="#B3FFFFFF" Offset="0"/>
                        <GradientStop Color="#00FFFFFF" Offset="1"/>
                    </RadialGradientBrush>
                </Rectangle.Fill>
            </Rectangle>

            <Grid Margin="20,14,20,10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="42"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="34"/>
                    <RowDefinition Height="56"/>
                    <RowDefinition Height="22"/>
                </Grid.RowDefinitions>

                <!-- Top bar: the three requested buttons sit at the top-left. -->
                <Grid x:Name="TopBar" Grid.Row="0" Background="Transparent" Cursor="SizeAll">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                        <ToggleButton x:Name="PinButton" Style="{StaticResource PinToggle}" ToolTip="固定在桌面">
                            <TextBlock FontFamily="Segoe UI Symbol, Segoe MDL2 Assets"
                                       FontSize="14"
                                       Text="&#x1F588;"
                                       VerticalAlignment="Center"/>
                        </ToggleButton>
                        <Button x:Name="MinButton" Style="{StaticResource WindowButton}" Margin="6,0,0,0" ToolTip="最小化">
                            <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="10" Text="&#xE921;"/>
                        </Button>
                        <Button x:Name="CloseButton" Style="{StaticResource CloseButton}" Margin="6,0,0,0" ToolTip="退出">
                            <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="10" Text="&#xE8BB;"/>
                        </Button>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" IsHitTestVisible="False">
                        <Ellipse Width="6" Height="6" Fill="{StaticResource Coral}" Opacity="0.8" Margin="0,0,6,0"/>
                        <TextBlock Text="番茄时钟"
                                   FontFamily="Microsoft YaHei UI, Segoe UI"
                                   FontSize="11"
                                   Foreground="#8B7663"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </Grid>

                <!-- Timer ring and center readout. -->
                <Grid x:Name="RingArea" Grid.Row="1" Background="Transparent" Cursor="SizeAll">
                    <Grid Width="220" Height="220" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Grid x:Name="RingHost" Width="220" Height="220"/>

                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,2,0,0">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,4">
                                <Ellipse x:Name="StatusDot" Width="5" Height="5" Fill="{StaticResource Coral}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock x:Name="StatusText"
                                           Text="准备专注"
                                           FontFamily="Microsoft YaHei UI, Segoe UI"
                                           FontSize="10"
                                           Foreground="#8B7663"
                                           VerticalAlignment="Center"/>
                            </StackPanel>

                            <TextBlock x:Name="TimeText"
                                       Text="25:00"
                                       FontFamily="Bahnschrift Light, Segoe UI"
                                       FontSize="54"
                                       Foreground="{StaticResource Ink}"
                                       TextAlignment="Center"
                                       HorizontalAlignment="Center"
                                       TextOptions.TextFormattingMode="Display"
                                       Margin="0,-2,0,0"/>

                            <TextBlock x:Name="SubText"
                                       Text="25 分钟"
                                       FontFamily="Microsoft YaHei UI, Segoe UI"
                                       FontSize="10"
                                       Foreground="#9A8571"
                                       TextAlignment="Center"
                                       HorizontalAlignment="Center"
                                       Margin="0,0,0,0"/>
                        </StackPanel>
                    </Grid>
                </Grid>

                <!-- Quick durations. -->
                <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <ToggleButton x:Name="Preset25" Style="{StaticResource PresetToggle}" Content="25分" IsChecked="True"/>
                    <ToggleButton x:Name="Preset30" Style="{StaticResource PresetToggle}" Content="30分"/>
                    <ToggleButton x:Name="Preset45" Style="{StaticResource PresetToggle}" Content="45分"/>
                    <ToggleButton x:Name="PresetCustom" Style="{StaticResource PresetToggle}" Content="自定义" Margin="0"/>
                </StackPanel>

                <!-- Main action and reset. -->
                <Grid Grid.Row="3" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Button x:Name="PrimaryButton" Style="{StaticResource PrimaryButton}" Width="190">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock x:Name="PrimaryIcon"
                                           FontFamily="Segoe MDL2 Assets"
                                           FontSize="13"
                                           Text="&#xE768;"
                                           VerticalAlignment="Center"
                                           Margin="0,0,8,0"/>
                                <TextBlock x:Name="PrimaryLabel"
                                           Text="开始专注"
                                           FontSize="13"
                                           FontWeight="SemiBold"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Button x:Name="ResetButton" Style="{StaticResource RoundIconButton}" Margin="10,0,0,0" ToolTip="重置本轮">
                            <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="14" Text="&#xE72C;"/>
                        </Button>
                    </StackPanel>
                </Grid>

                <!-- Eye-care footer. -->
                <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
                    <TextBlock FontFamily="Segoe MDL2 Assets"
                               FontSize="9"
                               Text="&#xE890;"
                               Foreground="#A38D77"
                               VerticalAlignment="Center"
                               Margin="0,0,5,0"/>
                    <TextBlock Text="护眼提醒 · 20-20-20"
                               FontFamily="Microsoft YaHei UI, Segoe UI"
                               FontSize="9"
                               Foreground="#A38D77"
                               VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>

            <!-- Custom duration overlay. -->
            <Border x:Name="CustomOverlay"
                    Visibility="Collapsed"
                    Background="#B0F2E7D7"
                    CornerRadius="26"
                    Panel.ZIndex="10"
                    Opacity="0">
                <Border x:Name="CustomCard"
                        Width="252"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Background="#FFFCF7"
                        CornerRadius="20"
                        Padding="20,18,20,18"
                        BorderBrush="#66FFFFFF"
                        BorderThickness="1"
                        RenderTransformOrigin="0.5,0.5">
                    <Border.Effect>
                        <DropShadowEffect Color="#4D3323" BlurRadius="22" ShadowDepth="5" Direction="270" Opacity="0.28"/>
                    </Border.Effect>

                    <StackPanel>
                        <Grid>
                            <TextBlock Text="自定义倒计时"
                                       FontFamily="Microsoft YaHei UI, Segoe UI"
                                       FontSize="16"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource Ink}"
                                       VerticalAlignment="Center"/>
                            <Button x:Name="CustomClose"
                                    Width="24" Height="24"
                                    HorizontalAlignment="Right"
                                    Style="{StaticResource WindowButton}"
                                    ToolTip="关闭">
                                <TextBlock Text="&#xE711;" FontFamily="Segoe MDL2 Assets" FontSize="10"/>
                            </Button>
                        </Grid>

                        <TextBlock Text="设置本轮时长 · 最长 180 分钟"
                                   FontFamily="Microsoft YaHei UI, Segoe UI"
                                   FontSize="10"
                                   Foreground="{StaticResource Muted}"
                                   Margin="0,4,0,0"/>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,15,0,0">
                            <Border Width="82" Height="50" Background="#FBF3E7" BorderBrush="#E6D2B8" BorderThickness="1" CornerRadius="14">
                                <TextBox x:Name="CustomMinutesBox" Style="{StaticResource DurationBox}" Width="70" Text="25"/>
                            </Border>
                            <TextBlock Text="分"
                                       FontFamily="Microsoft YaHei UI, Segoe UI"
                                       FontSize="11"
                                       Foreground="{StaticResource Muted}"
                                       VerticalAlignment="Center"
                                       Margin="7,0,12,0"/>
                            <Border Width="66" Height="50" Background="#FBF3E7" BorderBrush="#E6D2B8" BorderThickness="1" CornerRadius="14">
                                <TextBox x:Name="CustomSecondsBox" Style="{StaticResource DurationBox}" Width="54" MaxLength="2" Text="00"/>
                            </Border>
                            <TextBlock Text="秒"
                                       FontFamily="Microsoft YaHei UI, Segoe UI"
                                       FontSize="11"
                                       Foreground="{StaticResource Muted}"
                                       VerticalAlignment="Center"
                                       Margin="7,0,0,0"/>
                        </StackPanel>

                        <TextBlock x:Name="CustomError"
                                   Text=""
                                   FontFamily="Microsoft YaHei UI, Segoe UI"
                                   FontSize="9.5"
                                   Foreground="#C74E39"
                                   TextAlignment="Center"
                                   Height="17"
                                   Margin="0,5,0,0"/>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,1,0,0">
                            <Button x:Name="Chip5" Style="{StaticResource MiniChip}" Content="5分"/>
                            <Button x:Name="Chip15" Style="{StaticResource MiniChip}" Content="15分"/>
                            <Button x:Name="Chip20" Style="{StaticResource MiniChip}" Content="20分"/>
                            <Button x:Name="Chip30" Style="{StaticResource MiniChip}" Content="30分" Margin="0"/>
                        </StackPanel>

                        <Grid Margin="0,15,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Button x:Name="CustomCancel" Grid.Column="0" Style="{StaticResource GhostButton}" Content="取消"/>
                            <Button x:Name="CustomApply" Grid.Column="2" Style="{StaticResource DialogPrimary}" Content="设为时长"/>
                        </Grid>
                    </StackPanel>
                </Border>
            </Border>

            <!-- Completion / eye-care overlay. -->
            <Border x:Name="FinishOverlay"
                    Visibility="Collapsed"
                    Background="#B0F2E7D7"
                    CornerRadius="26"
                    Panel.ZIndex="11"
                    Opacity="0">
                <Border x:Name="FinishCard"
                        Width="266"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Background="#FFFCF7"
                        CornerRadius="20"
                        Padding="22,20,22,20"
                        BorderBrush="#66FFFFFF"
                        BorderThickness="1"
                        RenderTransformOrigin="0.5,0.5">
                    <Border.Effect>
                        <DropShadowEffect Color="#4D3323" BlurRadius="24" ShadowDepth="6" Direction="270" Opacity="0.30"/>
                    </Border.Effect>

                    <StackPanel>
                        <Grid>
                            <Border x:Name="FinishIconBubble" Width="48" Height="48" CornerRadius="24" Background="#1FE2644C" HorizontalAlignment="Center">
                                <TextBlock x:Name="FinishIcon"
                                           FontFamily="Segoe MDL2 Assets"
                                           FontSize="22"
                                           Text="&#xE890;"
                                           Foreground="{StaticResource Coral}"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                            </Border>
                            <Button x:Name="FinishClose"
                                    Width="24" Height="24"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Top"
                                    Style="{StaticResource WindowButton}"
                                    ToolTip="关闭">
                                <TextBlock Text="&#xE711;" FontFamily="Segoe MDL2 Assets" FontSize="10"/>
                            </Button>
                        </Grid>

                        <TextBlock x:Name="FinishEyebrow"
                                   Text="眼 保 健 操"
                                   FontFamily="Microsoft YaHei UI, Segoe UI"
                                   FontSize="9"
                                   Foreground="#B08B6E"
                                   TextAlignment="Center"
                                   Margin="0,9,0,3"/>

                        <TextBlock x:Name="FinishTitle"
                                   Text="该做眼保健操啦"
                                   FontFamily="Microsoft YaHei UI, Segoe UI"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource Ink}"
                                   TextAlignment="Center"/>

                        <TextBlock x:Name="FinishSubtitle"
                                   Text="时间到啦。看看远处，眨眨眼，&#x0a;给眼睛 5 分钟的放松时间。"
                                   FontFamily="Microsoft YaHei UI, Segoe UI"
                                   FontSize="10.5"
                                   Foreground="{StaticResource Muted}"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap"
                                   LineHeight="19"
                                   Margin="0,7,0,0"/>

                        <Button x:Name="FinishPrimary"
                                Style="{StaticResource DialogPrimary}"
                                Height="40"
                                Margin="0,16,0,0"
                                Content="休息 5 分钟"/>

                        <Button x:Name="FinishSecondary"
                                Style="{StaticResource GhostButton}"
                                Height="38"
                                Margin="0,8,0,0"
                                Content="稍后再休息"/>
                    </StackPanel>
                </Border>
            </Border>
        </Grid>
    </Border>
</Grid>

